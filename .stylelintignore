# The pre-commit hook runs stylelint from here, where a package's own
# .stylelintignore isn't read. These are the packages' entries, by path.
**/.next/**
**/dist-server/**
# An example's own CSS is a host page's, around the editor, not the SDK's:
# the family's token and scope rules are for the SDK's stylesheet.
packages/*/examples/*/src/**/*.css
packages/*/examples/*/app/**/*.css
