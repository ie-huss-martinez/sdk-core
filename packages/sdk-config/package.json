{
  "name": "@hussmartinez/sdk-config",
  "version": "0.13.6",
  "description": "Shared development configuration for the @hussmartinez SDK family.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ie-huss-martinez/sdk-core.git",
    "directory": "packages/sdk-config"
  },
  "bugs": {
    "url": "https://github.com/ie-huss-martinez/sdk-core/issues"
  },
  "homepage": "https://github.com/ie-huss-martinez/sdk-core/tree/main/packages/sdk-config#readme",
  "type": "module",
  "bin": {
    "hm-check-api-reports": "./src/api-extractor/cli.js",
    "hm-check-bundled-engines": "./src/bundled-engines/cli.js",
    "hm-check-hidden-unicode": "./src/hidden-unicode/cli.js",
    "hm-check-playwright-image": "./src/playwright-image/cli.js",
    "hm-check-single-copy": "./src/single-copy/cli.js",
    "hm-in-image": "./src/image/cli.js",
    "hm-lint-deps": "./src/dependency-cruiser/cli.js",
    "hm-lint-react": "./src/eslint-react/cli.js",
    "hm-netlog-errors": "./src/netlog/cli.js",
    "hm-size": "./src/size/cli.js",
    "hm-test-visual": "./src/visual/cli.js"
  },
  "exports": {
    "./api-extractor/base.json": "./api-extractor/base.json",
    "./biome": "./biome/base.jsonc",
    "./commitlint": "./src/commitlint/index.js",
    "./dependency-cruiser": "./src/dependency-cruiser/index.js",
    "./eslint-react": "./src/eslint-react/index.js",
    "./formats/hm-conformance/v1.schema.json": "./formats/hm-conformance/v1.schema.json",
    "./lint-staged": "./src/lint-staged/index.js",
    "./package.json": "./package.json",
    "./secretlint": "./src/secretlint/index.js",
    "./size": {
      "types": "./src/size/index.d.ts",
      "default": "./src/size/index.js"
    },
    "./stylelint": "./src/stylelint/index.js",
    "./testing/audio-output": {
      "types": "./src/testing/audio-output.d.ts",
      "default": "./src/testing/audio-output.js"
    },
    "./testing/browser-instances": {
      "types": "./src/testing/browser-instances.d.ts",
      "default": "./src/testing/browser-instances.js"
    },
    "./testing/conformance": {
      "types": "./src/testing/conformance.d.ts",
      "default": "./src/testing/conformance.js"
    },
    "./testing/firefox-labelled-by": {
      "types": "./src/testing/firefox-labelled-by.d.ts",
      "default": "./src/testing/firefox-labelled-by.js"
    },
    "./testing/firefox-labelled-by/setup": {
      "types": "./src/testing/firefox-labelled-by-setup.d.ts",
      "default": "./src/testing/firefox-labelled-by-setup.js"
    },
    "./testing/fonts": {
      "types": "./src/testing/fonts.d.ts",
      "default": "./src/testing/fonts.js"
    },
    "./testing/require-image": {
      "types": "./src/testing/require-image.d.ts",
      "default": "./src/testing/require-image.js"
    },
    "./testing/screen-reader": {
      "types": "./src/testing/screen-reader.d.ts",
      "default": "./src/testing/screen-reader.js"
    },
    "./testing/timeouts": {
      "types": "./src/testing/timeouts.d.ts",
      "default": "./src/testing/timeouts.js"
    },
    "./testing/visual": {
      "types": "./src/testing/visual.d.ts",
      "default": "./src/testing/visual.js"
    },
    "./tsconfig/*": "./tsconfig/*.json"
  },
  "files": [
    "api-extractor",
    "biome",
    "formats",
    "src",
    "tsconfig",
    "!src/**/*.test.js",
    "!src/**/*.check.ts"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "vitest run --project unit",
    "check:package": "publint run --pack pnpm --strict && attw --pack . --profile esm-only --exclude-entrypoints ./biome ./commitlint ./dependency-cruiser ./eslint-react ./lint-staged ./secretlint ./stylelint",
    "test:browser": "node src/image/cli.js vitest run --project browser",
    "test:browser:all": "node src/image/cli.js vitest run --project browser --mode all-browsers",
    "types:update": "node -e \"const fs = require('node:fs'); for (const file of fs.globSync('src/{testing,size}/*.d.ts')) fs.rmSync(file);\" && tsc -p tsconfig.types.json",
    "lint:deps": "hm-lint-deps src",
    "verify": "pnpm typecheck && pnpm lint:deps && pnpm test && pnpm test:browser && pnpm check:package",
    "verify:fast": "pnpm typecheck && pnpm test && pnpm lint:deps"
  },
  "dependencies": {
    "@commitlint/config-conventional": "catalog:",
    "@secretlint/secretlint-rule-preset-recommend": "catalog:",
    "postcss-selector-parser": "catalog:",
    "postcss-value-parser": "catalog:",
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@commitlint/cli": "^21.2.4",
    "@guidepup/virtual-screen-reader": "^0.33.0",
    "@microsoft/api-extractor": "^7.60.1",
    "@playwright/test": "^1.65.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/browser-playwright": "5.1.0",
    "ajv": "^8.20.0",
    "dependency-cruiser": "^18.7.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lint-staged": "^17.6.0",
    "secretlint": "^13.1.0",
    "stylelint": "^18.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "@biomejs/biome": {
      "optional": true
    },
    "@commitlint/cli": {
      "optional": true
    },
    "@guidepup/virtual-screen-reader": {
      "optional": true
    },
    "@microsoft/api-extractor": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    },
    "@typescript-eslint/parser": {
      "optional": true
    },
    "@vitest/browser-playwright": {
      "optional": true
    },
    "ajv": {
      "optional": true
    },
    "dependency-cruiser": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "lint-staged": {
      "optional": true
    },
    "secretlint": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/lint": "catalog:",
    "@commitlint/load": "catalog:",
    "@commitlint/types": "catalog:",
    "@guidepup/virtual-screen-reader": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@playwright/test": "catalog:",
    "@secretlint/node": "catalog:",
    "@size-limit/esbuild": "catalog:",
    "@size-limit/file": "catalog:",
    "@types/node": "catalog:",
    "@types/picomatch": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "ajv": "catalog:",
    "dependency-cruiser": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "lint-staged": "catalog:",
    "picomatch": "catalog:",
    "playwright": "catalog:",
    "postcss": "catalog:",
    "publint": "catalog:",
    "secretlint": "catalog:",
    "size-limit": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
