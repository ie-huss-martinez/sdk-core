{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  // Prose and tables stay hand-formatted: padded tables turn a one-cell edit
  // into a whole-table diff.
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  // The family's own rules (sdk-core ADR 0052). "config" resolves the path
  // from this file, so it works from the repository that extends it.
  "plugins": [{ "path": "./plugins/noUncheckedAbortListener.grit", "resolutionKind": "config" }],
  // Recommended rules, plus the ones that keep public code explicit about
  // types, imports and side effects.
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        // Conflicts with the tsconfig preset's noPropertyAccessFromIndexSignature.
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        // Hook dependency lists in published source are checked by React's
        // own plugin, through hm-lint-react, which also sees a dependency
        // made anew on every render. One rule, so a deliberate exception is
        // suppressed once (ADR 0063). A repository whose plugin rule is still
        // off turns this back on in its own biome.json until it isn't. Tests
        // and stories, which the plugin doesn't read, keep it: see overrides.
        "useExhaustiveDependencies": "off"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "useConst": "error",
        "useExportType": "error",
        "useImportType": "error",
        "useNodejsImportProtocol": "error"
      },
      "suspicious": {
        "noConsole": "error",
        "noExplicitAny": "error"
      }
    }
  },
  "overrides": [
    {
      // hm-lint-react reads published source only. Tests and stories keep
      // Biome's check of hook dependency lists, so every file is checked by
      // one of the two (ADR 0063).
      "includes": ["**/*.test.*", "**/*.stories.*"],
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": "error"
          }
        }
      }
    }
  ]
}
