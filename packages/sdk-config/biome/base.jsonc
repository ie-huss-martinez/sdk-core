{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  // Prose and tables stay hand-formatted: padded tables turn a one-cell edit
  // into a whole-table diff.
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  // The family's own rules (sdk-core ADR 0052). "config" resolves the path
  // from this file, so it works from the repository that extends it.
  "plugins": [{ "path": "./plugins/noUncheckedAbortListener.grit", "resolutionKind": "config" }],
  // Recommended rules, plus the ones that keep public code explicit about
  // types, imports and side effects.
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        // Conflicts with the tsconfig preset's noPropertyAccessFromIndexSignature.
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "useConst": "error",
        "useExportType": "error",
        "useImportType": "error",
        "useNodejsImportProtocol": "error"
      },
      "suspicious": {
        "noConsole": "error",
        "noExplicitAny": "error"
      }
    }
  }
}
