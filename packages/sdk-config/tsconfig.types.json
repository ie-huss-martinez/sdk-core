{
  // Declarations for the test-only and size entries, generated from their
  // JSDoc and committed next to them (pnpm types:update, which deletes the
  // old ones first: a stale declaration beside a module would be read in its
  // place). A test checks they're current, and the repository's biome.json
  // leaves them as tsc writes them.
  "extends": "./tsconfig/node.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "declarationMap": false,
    "rootDir": "src",
    "outDir": "src"
  },
  "files": [
    "src/size/entry.js",
    "src/size/imports.js",
    "src/size/index.js",
    "src/testing/audio-output.js",
    "src/testing/browser-instances.js",
    "src/testing/browsers.js",
    "src/testing/conformance.js",
    "src/testing/firefox-labelled-by.js",
    "src/testing/firefox-labelled-by-setup.js",
    "src/testing/fonts.js",
    "src/testing/require-image.js",
    "src/testing/screen-reader.js",
    "src/testing/timeouts.js",
    "src/testing/visual.js"
  ]
}
