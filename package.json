{
  "name": "sdk-core-workspace",
  "private": true,
  "description": "Workspace for the @hussmartinez SDK family.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "changeset": "changeset",
    "create-sdk-repo": "node scripts/create-sdk-repo.mjs",
    "lint": "biome check . && hm-check-hidden-unicode",
    "lint:css": "pnpm -r --if-present lint:css",
    "lint:deps": "pnpm -r --if-present lint:deps",
    "lint:react": "pnpm -r --if-present lint:react",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --filter \"./packages/*\" --if-present build",
    "test": "pnpm -r --if-present test && pnpm test:repo",
    "test:repo": "vitest run",
    "test:browser": "pnpm -r --if-present test:browser",
    "check:size": "pnpm -r --if-present check:size",
    "check:api": "pnpm -r --if-present check:api",
    "check:package": "pnpm -r --if-present check:package",
    "check:playwright-image": "hm-check-playwright-image",
    "check:single-copy": "hm-check-single-copy",
    "verify:repository": "pnpm lint && pnpm check:single-copy && pnpm check:playwright-image && pnpm test:repo",
    "verify": "pnpm verify:repository && pnpm -r --workspace-concurrency=1 --filter \"./packages/*\" verify",
    "verify:fast": "pnpm check:single-copy && pnpm check:playwright-image && pnpm test:repo && pnpm --filter \"...[origin/main]...\" --filter \"./packages/*\" --if-present build && pnpm --filter \"...[origin/main]\" --if-present verify:fast"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@hussmartinez/sdk-config": "workspace:*",
    "dependency-cruiser": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "secretlint": "catalog:",
    "stylelint": "catalog:",
    "vitest": "catalog:"
  }
}
