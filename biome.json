{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@hussmartinez/sdk-config/biome"],
  "files": {
    "includes": [
      "**",
      "!packages/sdk-config/src/testing/*.d.ts",
      "!packages/sdk-config/src/size/*.d.ts",
      "!packages/audio-sdk/conformance",
      "!packages/image-sdk/conformance",
      "!packages/learn-sdk/conformance",
      "!packages/notes-sdk/conformance",
      "!packages/pdf-sdk/conformance",
      "!packages/video-sdk/conformance"
    ]
  },
  "overrides": [
    {
      "includes": [
        "packages/ui/**",
        "!packages/ui/src/native.ts",
        "!packages/ui/src/native/**",
        "!packages/ui/examples/native/**"
      ],
      "linter": {
        "domains": {
          "reactNative": "none"
        }
      }
    },
    {
      "includes": ["packages/pdf-sdk/**", "packages/audio-sdk/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": "error"
          }
        }
      }
    }
  ]
}
